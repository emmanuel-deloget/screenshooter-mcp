pkgname=screenshooter-mcp-server
pkgver=PKGVER_PLACEHOLDER
pkgrel=1
pkgdesc="Screenshooter MCP Server (HTTP mode)"
arch=('x86_64' 'aarch64')
url="https://github.com/emmanuel-deloget/screenshooter-mcp"
license=('MIT')
depends=('systemd')
options=('!debug')
install=.install
source=("screenshooter-mcp"
        "authorize-portal.sh"
        "screenshooter-mcp-server.service"
        "com.deloget.ScreenshooterMCP-server.desktop")
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
	# Install binary
	install -Dm755 "${srcdir}/screenshooter-mcp" \
		"${pkgdir}/usr/bin/screenshooter-mcp-server"

	# Install config
	install -Dm644 /dev/null "${pkgdir}/etc/screenshooter-mcp/config.json"
	echo '{"log_level":"info","color":"auto","listen":"127.0.0.1:11777"}' \
		> "${pkgdir}/etc/screenshooter-mcp/config.json"

	# Install systemd service
	install -Dm644 "${srcdir}/screenshooter-mcp-server.service" \
		"${pkgdir}/usr/lib/systemd/user/screenshooter-mcp.service"

	# Install desktop file
	install -Dm644 "${srcdir}/com.deloget.ScreenshooterMCP-server.desktop" \
		"${pkgdir}/etc/xdg/autostart/com.deloget.ScreenshooterMCP.desktop"

	# Install authorize script
	install -Dm755 "${srcdir}/authorize-portal.sh" \
		"${pkgdir}/usr/lib/screenshooter-mcp/authorize-portal.sh"

	# Install GNOME extensions
	install -d "${pkgdir}/usr/share/screenshooter-mcp/extensions"
	cp -r "${startdir}/gnome-extension/"* \
		"${pkgdir}/usr/share/screenshooter-mcp/extensions/"
}
